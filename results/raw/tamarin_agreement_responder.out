rule (modulo E) I_2:
   [
   St_I_1( $I, $R, ~si, pkR, ~ei, ck3, hT3(pkR, 'g'^~ei, msgS, msgT) ),
   !Psk( $I, $R, psk ),
   In( <Er, 
        aead(kdf3c(kdf1(kdf1(kdf1(ck3, Er), Er^~ei), Er^~si), psk), 'empty',
             hT5(pkR, 'g'^~ei, msgS, msgT, Er,
                 kdf3b(kdf1(kdf1(kdf1(ck3, Er), Er^~ei), Er^~si), psk)))
       >
   )
   ]
  --[
  I_Done( $I, $R, 'g'^~si, pkR,
          kdf2a(kdf3a(kdf1(kdf1(kdf1(ck3, Er), Er^~ei), Er^~si), psk), 'kempty'),
          kdf2b(kdf3a(kdf1(kdf1(kdf1(ck3, Er), Er^~ei), Er^~si), psk), 'kempty')
  ),
  SessionKey( $I,
              kdf2a(kdf3a(kdf1(kdf1(kdf1(ck3, Er), Er^~ei), Er^~si), psk), 'kempty')
  ),
  SessionKey( $I,
              kdf2b(kdf3a(kdf1(kdf1(kdf1(ck3, Er), Er^~ei), Er^~si), psk), 'kempty')
  )
  ]->
   [
   !Session_I( $I, $R,
               kdf2a(kdf3a(kdf1(kdf1(kdf1(ck3, Er), Er^~ei), Er^~si), psk), 'kempty'),
               kdf2b(kdf3a(kdf1(kdf1(kdf1(ck3, Er), Er^~ei), Er^~si), psk), 'kempty')
   )
   ]

  /*
  rule (modulo AC) I_2:
     [
     St_I_1( $I, $R, ~si, pkR, ~ei, ck3, hT3(pkR, 'g'^~ei, msgS, msgT) ),
     !Psk( $I, $R, psk ),
     In( <Er, 
          aead(kdf3c(kdf1(kdf1(kdf1(ck3, Er), z), z.1), psk), 'empty',
               hT5(pkR, 'g'^~ei, msgS, msgT, Er,
                   kdf3b(kdf1(kdf1(kdf1(ck3, Er), z), z.1), psk)))
         >
     )
     ]
    --[
    I_Done( $I, $R, 'g'^~si, pkR,
            kdf2a(kdf3a(kdf1(kdf1(kdf1(ck3, Er), z), z.1), psk), 'kempty'),
            kdf2b(kdf3a(kdf1(kdf1(kdf1(ck3, Er), z), z.1), psk), 'kempty')
    ),
    SessionKey( $I,
                kdf2a(kdf3a(kdf1(kdf1(kdf1(ck3, Er), z), z.1), psk), 'kempty')
    ),
    SessionKey( $I,
                kdf2b(kdf3a(kdf1(kdf1(kdf1(ck3, Er), z), z.1), psk), 'kempty')
    )
    ]->
     [
     !Session_I( $I, $R,
                 kdf2a(kdf3a(kdf1(kdf1(kdf1(ck3, Er), z), z.1), psk), 'kempty'),
                 kdf2b(kdf3a(kdf1(kdf1(kdf1(ck3, Er), z), z.1), psk), 'kempty')
     )
     ]
    variants (modulo AC)
     1. ~ei   = ~ei.17
        ~si   = ~si.18
        Er    = Er.19
        z     = Er.19^~ei.17
        z.1   = Er.19^~si.18
    
     2. ~ei   = ~ei.24
        ~si   = ~ei.24
        Er    = z.33^inv(~ei.24)
        z     = z.33
        z.1   = z.33
    
     3. ~ei   = ~ei.24
        ~si   = ~si.25
        Er    = z.33^inv(~ei.24)
        z     = z.33
        z.1   = z.33^(~si.25*inv(~ei.24))
    
     4. ~ei   = ~ei.25
        ~si   = ~si.26
        Er    = z.35^inv(~si.26)
        z     = z.35^(~ei.25*inv(~si.26))
        z.1   = z.35
    
     5. ~ei   = ~ei.178
        ~si   = ~si.179
        Er    = x.351^x.352
        z     = x.351^(~ei.178*x.352)
        z.1   = x.351^(~si.179*x.352)
    
     6. ~ei   = ~ei.179
        ~si   = ~ei.179
        Er    = x.353^inv((~ei.179*x.354))
        z     = x.353^inv(x.354)
        z.1   = x.353^inv(x.354)
    
     7. ~ei   = ~ei.179
        ~si   = ~ei.179
        Er    = x.353^(x.354*inv(~ei.179))
        z     = x.353^x.354
        z.1   = x.353^x.354
    
     8. ~ei   = ~ei.179
        ~si   = ~si.180
        Er    = x.353^inv((~si.180*x.354))
        z     = x.353^(~ei.179*inv((~si.180*x.354)))
        z.1   = x.353^inv(x.354)
    
     9. ~ei   = ~ei.179
        ~si   = ~si.180
        Er    = x.353^(x.354*inv(~si.180))
        z     = x.353^(~ei.179*x.354*inv(~si.180))
        z.1   = x.353^x.354
    
    10. ~ei   = ~ei.179
        ~si   = ~si.180
        Er    = x.354^inv((~ei.179*~si.180))
        z     = x.354^inv(~si.180)
        z.1   = x.354^inv(~ei.179)
    
    11. ~ei   = ~ei.180
        ~si   = ~ei.180
        Er    = x.354^(x.355*inv((~ei.180*x.356)))
        z     = x.354^(x.355*inv(x.356))
        z.1   = x.354^(x.355*inv(x.356))
    
    12. ~ei   = ~ei.180
        ~si   = ~si.181
        Er    = x.354^(x.355*inv((~si.181*x.356)))
        z     = x.354^(~ei.180*x.355*inv((~si.181*x.356)))
        z.1   = x.354^(x.355*inv(x.356))
    
    13. ~ei   = ~ei.180
        ~si   = ~si.181
        Er    = x.355^inv((~ei.180*~si.181*x.356))
        z     = x.355^inv((~si.181*x.356))
        z.1   = x.355^inv((~ei.180*x.356))
    
    14. ~ei   = ~ei.180
        ~si   = ~si.181
        Er    = x.355^inv((~ei.180*x.356))
        z     = x.355^inv(x.356)
        z.1   = x.355^(~si.181*inv((~ei.180*x.356)))
    
    15. ~ei   = ~ei.180
        ~si   = ~si.181
        Er    = x.355^(x.356*inv(~ei.180))
        z     = x.355^x.356
        z.1   = x.355^(~si.181*x.356*inv(~ei.180))
    
    16. ~ei   = ~ei.180
        ~si   = ~si.181
        Er    = x.355^(x.356*inv((~ei.180*~si.181)))
        z     = x.355^(x.356*inv(~si.181))
        z.1   = x.355^(x.356*inv(~ei.180))
    
    17. ~ei   = ~ei.181
        ~si   = ~si.182
        Er    = x.356^(x.357*inv((~ei.181*~si.182*x.358)))
        z     = x.356^(x.357*inv((~si.182*x.358)))
        z.1   = x.356^(x.357*inv((~ei.181*x.358)))
    
    18. ~ei   = ~ei.181
        ~si   = ~si.182
        Er    = x.356^(x.357*inv((~ei.181*x.358)))
        z     = x.356^(x.357*inv(x.358))
        z.1   = x.356^(~si.182*x.357*inv((~ei.181*x.358)))
    
    19. Er    = DH_neutral
        z     = DH_neutral
        z.1   = DH_neutral
  */

rule (modulo E) I_Transport:
   [ !Session_I( $I, $R, tkI, tkR ), Fr( ~m ) ]
  --[ I_Sent( $I, $R, tkI ) ]->
   [ Out( aead(tkI, ~m, 'transport') ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) R_Transport:
   [ !Session_R( $I, $R, tkI, tkR ), In( aead(tkI, m, 'transport') ) ]
  --[ R_Complete( $I, $R, tkI, tkR ) ]->
   [ ]

  /* has exactly the trivial AC variant */

lemma executable:
  exists-trace
  "∃ I R pkI pkR tkI tkR #i #j.
    ((((I_Done( I, R, pkI, pkR, tkI, tkR ) @ #i) ∧
       (R_Done( I, R, pkI, pkR, tkI, tkR ) @ #j)) ∧
      (¬(∃ #r. RevealLtk( I ) @ #r))) ∧
     (¬(∃ #r. RevealLtk( R ) @ #r))) ∧
    (¬(∃ A B #r. RevealPsk( A, B ) @ #r))"
/*
guarded formula characterizing all satisfying traces:
"∃ I R pkI pkR tkI tkR #i #j.
  (I_Done( I, R, pkI, pkR, tkI, tkR ) @ #i) ∧
  (R_Done( I, R, pkI, pkR, tkI, tkR ) @ #j)
 ∧
  (∀ #r. (RevealLtk( I ) @ #r) ⇒ ⊥) ∧
  (∀ #r. (RevealLtk( R ) @ #r) ⇒ ⊥) ∧
  (∀ A B #r. (RevealPsk( A, B ) @ #r) ⇒ ⊥)"
*/
by sorry

lemma session_key_secrecy:
  all-traces
  "∀ I R pkI pkR tkI tkR #i.
    ((((I_Done( I, R, pkI, pkR, tkI, tkR ) @ #i) ∧
       (¬(∃ #r. RevealLtk( I ) @ #r))) ∧
      (¬(∃ #r. RevealLtk( R ) @ #r))) ∧
     (¬(∃ #r. RevealPsk( I, R ) @ #r))) ⇒
    (¬(∃ #k. K( tkI ) @ #k))"
/*
guarded formula characterizing all counter-examples:
"∃ I R pkI pkR tkI tkR #i.
  (I_Done( I, R, pkI, pkR, tkI, tkR ) @ #i)
 ∧
  (∀ #r. (RevealLtk( I ) @ #r) ⇒ ⊥) ∧
  (∀ #r. (RevealLtk( R ) @ #r) ⇒ ⊥) ∧
  (∀ #r. (RevealPsk( I, R ) @ #r) ⇒ ⊥) ∧
  (∃ #k. (K( tkI ) @ #k))"
*/
by sorry

lemma forward_secrecy:
  all-traces
  "∀ I R pkI pkR tkI tkR #i.
    ((((I_Done( I, R, pkI, pkR, tkI, tkR ) @ #i) ∧
       (¬(∃ #r. RevealPsk( I, R ) @ #r))) ∧
      (∀ #r. (RevealLtk( I ) @ #r) ⇒ (#i < #r))) ∧
     (∀ #r. (RevealLtk( R ) @ #r) ⇒ (#i < #r))) ⇒
    (¬(∃ #k. K( tkI ) @ #k))"
/*
guarded formula characterizing all counter-examples:
"∃ I R pkI pkR tkI tkR #i.
  (I_Done( I, R, pkI, pkR, tkI, tkR ) @ #i)
 ∧
  (∀ #r. (RevealPsk( I, R ) @ #r) ⇒ ⊥) ∧
  (∀ #r. (RevealLtk( I ) @ #r) ⇒ #i < #r) ∧
  (∀ #r. (RevealLtk( R ) @ #r) ⇒ #i < #r) ∧
  (∃ #k. (K( tkI ) @ #k))"
*/
by sorry

lemma agreement_responder:
  all-traces
  "∀ I R pkI pkR tkI tkR #i.
    (((R_Done( I, R, pkI, pkR, tkI, tkR ) @ #i) ∧
      (¬(∃ #r. RevealLtk( I ) @ #r))) ∧
     (¬(∃ #r. RevealLtk( R ) @ #r))) ⇒
    (∃ #j. (I_Begin( I, R, pkI, pkR ) @ #j) ∧ (#j < #i))"
/*
guarded formula characterizing all counter-examples:
"∃ I R pkI pkR tkI tkR #i.
  (R_Done( I, R, pkI, pkR, tkI, tkR ) @ #i)
 ∧
  (∀ #r. (RevealLtk( I ) @ #r) ⇒ ⊥) ∧
  (∀ #r. (RevealLtk( R ) @ #r) ⇒ ⊥) ∧
  (∀ #j. (I_Begin( I, R, pkI, pkR ) @ #j) ⇒ ¬(#j < #i))"
*/
simplify
solve( !Ltk( $R, ~sr ) ▶₁ #i )
  case Register_Static
  solve( !Pk( $I, pkI ) ▶₂ #i )
    case Register_Static
    solve( !Psk( $I, $R, psk ) ▶₃ #i )
      case Register_Psk
