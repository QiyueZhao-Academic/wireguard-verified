rule (modulo E) Register_Static:
   [ Fr( ~s ) ]
  --[ RegisterStatic( $A ) ]->
   [ !Ltk( $A, ~s ), !Pk( $A, 'g'^~s ), Out( 'g'^~s ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) Register_Psk:
   [ Fr( ~psk ) ] --[ RegisterPsk( $A, $B ) ]-> [ !Psk( $A, $B, ~psk ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) Reveal_Ltk:
   [ !Ltk( A, s ) ] --[ RevealLtk( A ) ]-> [ Out( s ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) Reveal_Psk:
   [ !Psk( A, B, psk ) ] --[ RevealPsk( A, B ) ]-> [ Out( psk ) ]

  /* has exactly the trivial AC variant */

